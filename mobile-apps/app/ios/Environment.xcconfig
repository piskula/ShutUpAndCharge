// prod = real backend + Keycloak; demo = in-memory demo data (no Keycloak/backend, same bundle ID).
APP_ENVIRONMENT = prod

SUAC_BUNDLE_IDENTIFIER_prod = org.momosi.shutupandcharge
SUAC_DISPLAY_NAME_prod = Shut Up And Charge
SUAC_API_BASE_URL_prod = https:/$()/charge.momosi.org/
SUAC_REALM_URL_prod = https:/$()/sso.momosi.org/realms/momosi/
SUAC_OAUTH_CLIENT_ID_prod = mobile-client
SUAC_APP_SCHEME_prod = org.momosi.shutupandcharge
SUAC_APP_ICON_NAME_prod = AppIcon
SUAC_USE_MOCK_DATA_prod = NO

SUAC_BUNDLE_IDENTIFIER_demo = $(SUAC_BUNDLE_IDENTIFIER_prod)
SUAC_DISPLAY_NAME_demo = SUAC Demo
SUAC_API_BASE_URL_demo = $(SUAC_API_BASE_URL_prod)
SUAC_REALM_URL_demo = $(SUAC_REALM_URL_prod)
SUAC_OAUTH_CLIENT_ID_demo = $(SUAC_OAUTH_CLIENT_ID_prod)
SUAC_APP_SCHEME_demo = $(SUAC_APP_SCHEME_prod)
SUAC_APP_ICON_NAME_demo = $(SUAC_APP_ICON_NAME_prod)
SUAC_USE_MOCK_DATA_demo = YES

SUAC_BUNDLE_IDENTIFIER = $(SUAC_BUNDLE_IDENTIFIER_$(APP_ENVIRONMENT))
SUAC_DISPLAY_NAME = $(SUAC_DISPLAY_NAME_$(APP_ENVIRONMENT))
SUAC_API_BASE_URL = $(SUAC_API_BASE_URL_$(APP_ENVIRONMENT))
SUAC_REALM_URL = $(SUAC_REALM_URL_$(APP_ENVIRONMENT))
SUAC_OAUTH_CLIENT_ID = $(SUAC_OAUTH_CLIENT_ID_$(APP_ENVIRONMENT))
SUAC_APP_SCHEME = $(SUAC_APP_SCHEME_$(APP_ENVIRONMENT))
SUAC_APP_ICON_NAME = $(SUAC_APP_ICON_NAME_$(APP_ENVIRONMENT))
SUAC_USE_MOCK_DATA = $(SUAC_USE_MOCK_DATA_$(APP_ENVIRONMENT))